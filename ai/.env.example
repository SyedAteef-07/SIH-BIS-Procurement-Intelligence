EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# English remains the default. Preload the optional BGE-M3 mode only for demos.
EMBEDDING_MODE=english
MULTILINGUAL_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
DATASET_PATH=data/sample_standards.json
RETRIEVAL_K=20
FINAL_K=5
RETRIEVAL_MODE=hybrid
RRF_K=60
# Disabled until calibrated with representative held-out queries.
MIN_RERANKER_SCORE=
MODEL_DEVICE=cpu
# Deterministic NLP enrichment is opt-in; original query still drives reranking.
QUERY_ENRICHMENT=false
